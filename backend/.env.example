# Market 2.0 Environment Configuration
# Copy to .env and edit values as needed

# Auth Settings
MARKET_API_TOKEN=your-secure-token-here
FRONTEND_URL=http://localhost:3000

# Provider: "mock" (default, offline) or "real" (yfinance, requires internet)
DATA_PROVIDER=mock

# PostgreSQL / TimescaleDB Connection
DATABASE_URL=postgresql://market_user:market_password@localhost:5432/market_db

# DhanHQ API Credentials (Required if DATA_PROVIDER=dhan)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox Analytics Token (Required if DATA_PROVIDER=upstox)
UPSTOX_ANALYTICS_TOKEN=

# OpenRouter LLM Configuration
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT=15.0
AI_MAX_REQUESTS_PER_RUN=1
